{
  "Urls": "https://localhost:7112",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Stellaegis": {
    "Issuer": {
      "Bearer": {
        "Authority": "https://localhost:7111",
        "Audiences": [ "inventory" ]
      },
      "M2M": {
        "Authority": "https://localhost:7111",
        "ClientId": "inventory",
        "ClientSecret": "inventory-sample-secret-change-me-per-deployment"
      },
      "Client": {
        "BaseUrl": "https://localhost:7111/api/admin/issuer"
      },
      "Admission": {
        "ReconcileInterval": "00:00:05"
      }
    }
  }
}
