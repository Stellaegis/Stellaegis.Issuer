<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- A host that has an account layout of its own, Pages/Shared/_AccountLayout.cshtml — what Stellaegis.Identity.Server
       gives a host —: what the test of the layout adds before the package, as an application does. Test-only,
       never packed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Issuer.Tests.HostPages</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stellaegis.Issuer.Server\Stellaegis.Issuer.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
