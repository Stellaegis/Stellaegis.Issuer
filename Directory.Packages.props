<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Stellaegis: the Microsoft.Extensions abstractions come with Stellaegis.Primitives.Hosting -->
    <PackageVersion Include="Stellaegis.Primitives" Version="5.4.0" />
    <PackageVersion Include="Stellaegis.Primitives.Hosting" Version="5.4.0" />
    <PackageVersion Include="Stellaegis.Primitives.Data" Version="5.4.0" />
    <PackageVersion Include="Stellaegis.Primitives.AspNetCore" Version="5.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- The accounts, for the example host that composes them with the issuer: packages, never a project reference -->
    <PackageVersion Include="Stellaegis.Identity" Version="6.3.0" />
    <PackageVersion Include="Stellaegis.Identity.PostgreSQL" Version="6.3.0" />
    <PackageVersion Include="Stellaegis.Identity.AspNetCore" Version="6.3.0" />
    <PackageVersion Include="Stellaegis.Identity.Server" Version="6.3.0" />
    <!-- The OpenID Connect issuer: OpenIddict over EF Core at run time; the schema is installed by scripts -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Transitive dependencies of the EF Core providers, pinned above the versions NuGet audits as vulnerable (NU1902/NU1903) -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Resource servers: bearer validation -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- PostgreSQL -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Testing -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>
</Project>
