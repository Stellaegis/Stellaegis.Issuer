<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Issuer.Client</RootNamespace>
    <PackageId>Stellaegis.Issuer.Client</PackageId>
    <Description>What a host that is not the issuer takes of Stellaegis.Issuer: the validation of the bearer tokens it issued, the admission of the revoked tokens — read from the issuer over HTTP, kept in memory, reconciled —, and the client credentials a service speaks with, as a token provider and a handler on its HTTP clients. No OpenIddict here: the issuer itself takes this package too, for its own routes.</Description>
    <PackageTags>stellaegis;issuer;oidc;bearer;resource-server;client-credentials;admission</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellaegis.Primitives" />
    <PackageReference Include="Stellaegis.Primitives.Hosting" />
    <PackageReference Include="Stellaegis.Primitives.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <InternalsVisibleTo Include="Stellaegis.Issuer" />
    <InternalsVisibleTo Include="Stellaegis.Issuer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
